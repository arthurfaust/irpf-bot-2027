RAW_FILE=
OUTPUT_FILE=
CLIENT_DATA=data/dados.example.json
LOG_LEVEL=INFO

# Etapa de IA (uv run irpf-bot-2027-ia, docs/adr/0029). Só a chave do provedor escolhido em --provedor.
# Claude: chave criada em console.anthropic.com > API Keys (começa com sk-ant-). Sem ela, o SDK usa o
# login de `ant auth login`. Nunca faça commit do config/.env com a chave preenchida.
ANTHROPIC_API_KEY=
